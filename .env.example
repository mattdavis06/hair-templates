# Copy to .env.local for local development; set the same keys in Vercel → Settings → Environment Variables.

# Public address of the site, e.g. https://hair.mdavis.dev. Used for canonical
# URLs, share images, the sitemap and email links. Leave unset locally.
NEXT_PUBLIC_SITE_URL=

# Set to "true" to let search engines index the site. Demos stay noindex by default.
NEXT_PUBLIC_ALLOW_INDEXING=

# Form emails (Resend). Leave either blank and forms still work, but nothing is sent.
RESEND_API_KEY=
# A domain verified in Resend. Emails come from <brand>@this-domain, e.g. northside@demo.mdavis.dev
EMAIL_FROM_DOMAIN=
# Optional: receives a copy of every contact-form enquiry.
CONTACT_INBOX=
# Optional: public site that serves email images (logos). Defaults to NEXT_PUBLIC_SITE_URL,
# then the Vercel production URL. Mail clients can't load images from localhost or protected previews.
EMAIL_ASSET_URL=
